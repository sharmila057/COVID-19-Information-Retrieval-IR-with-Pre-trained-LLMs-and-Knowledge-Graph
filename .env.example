# ---------------------------------------------------------------------------
# .env.example
# ---------------------------------------------------------------------------
# Copy this file to `.env` (in the project root) and fill in your own
# values. NEVER commit your actual `.env` file to version control —
# it is already excluded via .gitignore.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string.
# Get this from Atlas: Database > Connect > Drivers > Python.
# Example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=

# Name of the MongoDB database to use (created automatically on first write).
MONGO_DB_NAME=covid_ir_system

# Google Gemini API key.
# Get this from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model to use (optional — defaults to gemini-1.5-flash if unset).
GEMINI_MODEL_NAME=gemini-1.5-flash
